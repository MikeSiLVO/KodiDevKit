        "context": [{ "key": "selector", "operator": "equal", "operand": "text.xml.kodi" }]
    },
    {
        "command": "kodidevkit_open_skin_image",
        "caption": "KodiDevKit: Open image",
        "context": [{ "key": "selector", "operator": "equal", "operand": "text.xml.kodi" }]
    }
